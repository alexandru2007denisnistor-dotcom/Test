# Kopiere diese Datei nach ".env" und trage deine Schlüssel ein.
# Deezer funktioniert ohne Schlüssel. Spotify und YouTube sind optional,
# erweitern die Auswahl aber enorm.

# Server
PORT=3000
# 127.0.0.1 = nur dieser Rechner. 0.0.0.0 = auch Handy/Tablet im gleichen WLAN.
HOST=127.0.0.1

# Spotify – https://developer.spotify.com/dashboard → "Create app"
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Land für Verfügbarkeit der Titel (ISO-Code)
SPOTIFY_MARKET=DE

# YouTube Data API v3 – https://console.cloud.google.com → API aktivieren → API-Schlüssel
YOUTUBE_API_KEY=
YOUTUBE_REGION=DE
